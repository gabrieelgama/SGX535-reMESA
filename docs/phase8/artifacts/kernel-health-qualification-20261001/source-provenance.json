  "function": "psb_intel_lvds_get_max_backlight",
  "selected_lines": [
    "/*",
    " * Returns the maximum level of the backlight duty cycle field.",
    " */",
    "static u32 psb_intel_lvds_get_max_backlight(struct drm_device *dev)",
    "{",
    "\tstruct drm_psb_private *dev_priv = dev->dev_private;",
    "\tu32 ret;",
    "",
    "\tif (gma_power_begin(dev, false)) {",
    "\t\tret = REG_READ(BLC_PWM_CTL);",
    "\t\tgma_power_end(dev);",
    "\t} else /* Powered off, use the saved value */",
    "\t\tret = dev_priv->regs.saveBLC_PWM_CTL;",
    "",
    "\t/* Top 15bits hold the frequency mask */",
    "\tret = (ret &  BACKLIGHT_MODULATION_FREQ_MASK) >>",
    "\t\t\t\t\tBACKLIGHT_MODULATION_FREQ_SHIFT;",
    "",
    "        ret *= 2;\t/* Return a 16bit range as needed for setting */",
    "        if (ret == 0)",
    "                dev_err(dev->dev, \"BL bug: Reg %08x save %08X\\n\",",
    "                        REG_READ(BLC_PWM_CTL), dev_priv->regs.saveBLC_PWM_CTL);",
    "\treturn ret;",
    "}",
    "",
    "/*"
