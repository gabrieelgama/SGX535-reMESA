import json, os, stat
paths=["/usr","/usr/local","/usr/local/libexec","/etc","/etc/sudoers.d"]
result={}
for path in paths:
 try:
  item=os.lstat(path)
  result[path]={"exists":True,"uid":item.st_uid,"gid":item.st_gid,"mode":oct(stat.S_IMODE(item.st_mode)),"directory":stat.S_ISDIR(item.st_mode),"group_or_other_writable":bool(item.st_mode & 0o022)}
 except FileNotFoundError: result[path]={"exists":False}
for path in ["/usr/local/libexec/sgx535-core-id","/etc/sudoers.d/sgx535-core-id"]:
 result[path]={"exists":os.path.lexists(path)}
print(json.dumps(result,sort_keys=True))
